<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:layoutDirection="rtl"
    android:background="@drawable/widget_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textColor="@color/w_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
      <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
    </LinearLayout>
    <TextView android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="↻" android:textColor="@color/w_primary" android:textSize="20sp" android:padding="6dp"/>
  </LinearLayout>
  <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:visibility="gone" android:textColor="@color/w_dim" android:textSize="13sp" android:paddingTop="10dp" android:textAlignment="viewStart"/>
  <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot0" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot1" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot2" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot3" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot4" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row5" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot5" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row6" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot6" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row7" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot7" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <LinearLayout android:id="@+id/row8" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp" android:visibility="gone">
    <TextView android:id="@+id/dot8" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="●" android:textSize="10sp" android:layout_marginEnd="6dp"/>
    <TextView android:id="@+id/txt8" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:textColor="@color/w_text" android:textSize="13sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
  </LinearLayout>
  <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"/>
  <TextView android:id="@+id/w_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/w_dim" android:textSize="10sp" android:textAlignment="viewEnd"/>
</LinearLayout>
