<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:layoutDirection="rtl"
    android:background="@drawable/widget_bg">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
      android:orientation="horizontal" android:gravity="center_vertical">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textColor="@color/w_text" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
      <TextView android:id="@+id/w_sub" android:layout_width="match_parent" android:layout_height="wrap_content"
          android:textColor="@color/w_dim" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:textAlignment="viewStart"/>
    </LinearLayout>
    <TextView android:id="@+id/w_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="↻" android:textColor="@color/w_primary" android:textSize="20sp" android:padding="6dp"/>
  </LinearLayout>
  <TextView android:id="@+id/w_msg" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:visibility="gone" android:textColor="@color/w_dim" android:textSize="13sp" android:paddingTop="10dp" android:textAlignment="viewStart"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
      android:orientation="vertical" android:gravity="center">
    <TextView android:id="@+id/w_big" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_primary" android:textSize="40sp" android:textStyle="bold"/>
    <TextView android:id="@+id/w_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="@color/w_dim" android:textSize="12sp"/>
    <TextView android:id="@+id/w_task" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/w_text" android:textSize="14sp" android:textStyle="bold" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:paddingTop="4dp"/>
    <TextView android:id="@+id/w_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="@color/w_dim" android:textSize="11sp" android:gravity="center" android:maxLines="1" android:ellipsize="end"/>
  </LinearLayout>
  <TextView android:id="@+id/w_footer" android:layout_width="match_parent" android:layout_height="wrap_content"
      android:textColor="@color/w_dim" android:textSize="10sp" android:textAlignment="viewEnd"/>
</LinearLayout>
